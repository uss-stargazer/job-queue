{
  "name": "@uss-stargazer/job-queue",
  "version": "0.0.4",
  "description": "A CLI app to keep track of jobs/tasks built around a couple of JSON files.",
  "author": "uss-stargazer",
  "license": "Apache-2.0",
  "repository": {  
    "type": "git",
    "url": "https://github.com/uss-stargazer/jobqueue.git"
  },
  "type": "module",
  "bin": {
    "job-queue": "./index.js",
    "jobq": "./index.js"
  },
  "files": ["index.js", "dist/", "!TODO"],
  "scripts": {
    "start": "node ./index.js",
    "clean": "rimraf coverage dist tmp",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint .",
    "prettier": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --write",
    "prettier:check": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --check",
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@inquirer/search": "^4.1.0",
    "@octokit/rest": "^22.0.1",
    "ansi-escapes": "^7.2.0",
    "chalk": "^5.6.2",
    "clear": "^0.1.0",
    "commander": "^14.0.2",
    "diff": "^8.0.3",
    "edit-like-git": "^1.0.2",
    "env-paths": "^4.0.0",
    "figlet": "^1.9.4",
    "inquirer": "^13.2.0",
    "tmp-promise": "^3.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.6",
    "@typescript-eslint/parser": "^8.52.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-api-utils": "^2.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
